# Recovery Copilot — Environment Configuration

# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (SQLite default for speed, or PostgreSQL in production)
DATABASE_URL=sqlite:///./recovery_copilot.db

# LLM Providers (Gemini 2.5 Flash is Primary, Claude is Optional)
GEMINI_API_KEY=sample-gemini-placeholder-key
ANTHROPIC_API_KEY=sk-ant-api03-sample-placeholder-key

# Razorpay Test API Keys (Payment Gateway Sandbox)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key

# Role-Based Access Control (RBAC) Keys
ADMIN_API_KEY=rc-admin-secret-key-2026
OPS_API_KEY=rc-ops-secret-key-2026

# Simulated Gateway / Messaging Provider Outage Testing (True/False)
SIMULATE_MESSAGING_OUTAGE=False

# Frontend (Vite) — Backend API URL (change to deployed URL in production)
VITE_API_URL=http://127.0.0.1:8000/api
